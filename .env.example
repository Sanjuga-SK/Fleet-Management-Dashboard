# ==============================================================================
# Bytebeam Fleet Management Dashboard — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your Supabase project credentials.
# If these variables are left empty, the application automatically boots in Demo Mode.

# Supabase Project API URL (Found in Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (Found in Supabase Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Force Demo Mode even if Supabase credentials are configured (true / false)
VITE_DEMO_MODE=false
